diff --git a/web/src/styles/_mixins.scss b/web/src/styles/_mixins.scss
new file mode 100644
index 0000000..a6a8938
--- /dev/null
+++ b/web/src/styles/_mixins.scss
@@ -0,0 +1,72 @@
+// Mixins partagés. Avant d'écrire du style dans un composant, chercher ici s'il existe déjà ;
+// si un motif apparaît dans deux composants, il devient un mixin ici.
+//
+// Utilisation dans un composant :  @use 'mixins' as m;   puis   @include m.panel;
+
+@use 'tokens' as t;
+
+/// Conteneur de page centré, avec marges latérales sur mobile.
+/// @param $max-width largeur maximale du contenu
+@mixin page($max-width: t.$width-page) {
+  max-width: $max-width;
+  margin: t.$space-16 auto;
+  padding: 0 t.$space-4;
+}
+
+/// Bloc encadré (carte, ligne de liste...).
+@mixin panel {
+  padding: t.$space-2 t.$space-3;
+  border-radius: t.$radius-md;
+  background: var(--color-bg);
+}
+
+/// Couleurs d'état : success | danger.
+/// @param $kind type d'état
+@mixin status($kind) {
+  @if $kind == success {
+    background: var(--color-success-bg);
+    color: var(--color-success-text);
+  } @else if $kind == danger {
+    background: var(--color-danger-bg);
+    color: var(--color-danger-text);
+  } @else {
+    @error "status(): état inconnu « #{$kind} » (attendu : success | danger)";
+  }
+}
+
+/// Liste sans puces ni retrait.
+@mixin reset-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+/// Contour visible au clavier uniquement (accessibilité).
+@mixin focus-ring {
+  &:focus-visible {
+    outline: 2px solid var(--color-focus);
+    outline-offset: 2px;
+  }
+}
+
+/// Bouton principal.
+@mixin button-primary {
+  padding: t.$space-2 t.$space-4;
+  border: none;
+  border-radius: t.$radius-md;
+  background: var(--color-primary);
+  color: var(--color-primary-contrast);
+  font: inherit;
+  cursor: pointer;
+  @include focus-ring;
+
+  &:disabled {
+    opacity: 0.5;
+    cursor: not-allowed;
+  }
+}
+
+/// Texte secondaire, moins contrasté.
+@mixin text-muted {
+  color: var(--color-text-muted);
+}
diff --git a/web/src/styles/_tokens.scss b/web/src/styles/_tokens.scss
new file mode 100644
index 0000000..2fe4630
--- /dev/null
+++ b/web/src/styles/_tokens.scss
@@ -0,0 +1,43 @@
+// Jetons de design : la SEULE source des couleurs, espacements, rayons et polices.
+// Les composants n'écrivent jamais de valeur en dur (#fff, 12px...) : ils utilisent ces variables.
+//
+// Les couleurs sont des variables CSS (--color-*) pour pouvoir changer de thème (sombre) sans recompiler.
+// Les espacements et rayons sont des variables SCSS : elles servent dans les calculs et les mixins.
+
+// --- Espacements (échelle de 4 px) ---
+$space-1: 0.25rem;
+$space-2: 0.5rem;
+$space-3: 0.75rem;
+$space-4: 1rem;
+$space-6: 1.5rem;
+$space-8: 2rem;
+$space-16: 4rem;
+
+// --- Rayons ---
+$radius-sm: 0.25rem;
+$radius-md: 0.375rem;
+$radius-lg: 0.75rem;
+
+// --- Typographie ---
+$font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
+$font-size-sm: 0.875rem;
+$font-size-md: 1rem;
+
+// --- Largeurs ---
+$width-narrow: 32rem;
+$width-page: 72rem;
+
+// --- Couleurs (thème clair) : appliquées sur :root dans styles.scss ---
+@mixin theme-light {
+  --color-bg: #ffffff;
+  --color-text: #1d1d1f;
+  --color-text-muted: #666666;
+  --color-border: #d9d9de;
+  --color-primary: #5b3cc4;
+  --color-primary-contrast: #ffffff;
+  --color-success-bg: #e7f6ec;
+  --color-success-text: #11643a;
+  --color-danger-bg: #fde8e8;
+  --color-danger-text: #b42318;
+  --color-focus: #5b3cc4;
+}
