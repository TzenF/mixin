# Copier en .env (jamais commité). Lu par docker compose.

# Ports sur ta machine. À changer si l'un est déjà pris (« address already in use »).
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=4200

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
# À déclarer à l'identique dans les Redirect URIs du dashboard. 127.0.0.1, pas localhost.
# Passe par le proxy Angular : front et API partagent la même origine (cookie de session).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4200/api/auth/spotify/callback

# --- Sécurité ---
# Clé Fernet qui chiffre les jetons Spotify en base. Générer avec :
#   docker compose exec api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La changer rend les jetons stockés illisibles : il faudra se reconnecter à Spotify.
TOKEN_ENCRYPTION_KEY=
# true dès que l'application est servie en HTTPS
SESSION_COOKIE_SECURE=false
